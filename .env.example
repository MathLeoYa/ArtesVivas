# Variables de entorno — Pulso Loja
# COPIAR COMO .env Y NO COMMITEAR .env AL REPOSITORIO

# ─── Base de Datos ───────────────────────────────────
POSTGRES_USER=pulsaloja
POSTGRES_PASSWORD=festivalArtes2026!
POSTGRES_DB=pulsaloja_db

# ─── Redis ───────────────────────────────────────────
REDIS_URL=redis://redis:6379

# ─── JWT ─────────────────────────────────────────────
# IMPORTANTE: Cambiar en producción por un valor seguro de al menos 64 caracteres
JWT_SECRET=dev-secret-change-in-production-pulso-loja-2026

# ─── Festival Config ──────────────────────────────────
# Centro geográfico del festival (Plaza de la Independencia, Loja, Ecuador)
FESTIVAL_CENTER_LAT=-3.9985
FESTIVAL_CENTER_LNG=-79.1972
FESTIVAL_PERIMETER_KM=2.5

# Radio en metros para notificar espectadores de flash-performances
FLASH_NOTIFICATION_RADIUS_M=500

# Radio en metros para validar votos (aplausómetro)
VOTE_RADIUS_M=200

# Radio en metros para sellar el pasaporte digital
STAMP_RADIUS_M=100

# ─── API Meteorológica ────────────────────────────────
# API del INAMHI o OpenWeatherMap para alertas climáticas
WEATHER_API_KEY=tu_api_key_aqui

# ─── Build ───────────────────────────────────────────
NODE_ENV=development
BUILD_TARGET=development

# ─── URLs Frontend ───────────────────────────────────
VITE_API_CATALOG_URL=http://localhost/catalog
VITE_API_GAMIFICATION_URL=http://localhost/gamification
VITE_WS_URL=ws://localhost/live
